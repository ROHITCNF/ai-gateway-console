# Copy to .env (git-ignored). Never commit real values (NFR-8, D16).

# Port the API listens on.
PORT=8787

# Postgres connection string. Leave unset to use PGlite (D16).
# Local dev: Neon `dev` branch, direct (non-pooled) URL. Used from task 1.3.
# DATABASE_URL=postgresql://<user>:<password>@<host>/<db>?sslmode=require

# PGlite data directory when DATABASE_URL is unset (git-ignored).
# PGLITE_DIR=.data/pglite

# Simulator (D2, D16.4). SIM_ENABLED=false stops writes (saves Neon compute hours).
# SIM_SEED=42
# SIM_RATE=1
# SIM_ENABLED=true
